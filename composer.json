{
    "name": "jam/dbsimple-models",
    "description": "ActiveRecord / Model layer for Jam DbSimple",
    "keywords": ["database", "models", "active-record", "orm", "dbsimple"],
    "type": "library",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jam Contributors",
            "role": "Maintainer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../dbsimple"
        }
    ],
    "require": {
        "php": ">=8.1",
        "jam/dbsimple": "dev-main || ^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jam\\Models\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jam\\Models\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

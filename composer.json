{
    "name": "jam/dbsimple-models",
    "description": "ActiveRecord / Model layer for Jam DbSimple",
    "keywords": [
        "database",
        "models",
        "active-record",
        "orm",
        "dbsimple"
    ],
    "type": "library",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jam Contributors",
            "role": "Maintainer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../dbsimple"
        }
    ],
    "require": {
        "php": ">=8.4",
        "jam/dbsimple": "dev-main || ^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jam\\Models\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jam\\Models\\Tests\\": "tests/",
            "Jam\\Models\\Examples\\": "examples/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test:mysql": "DBSIMPLE_TEST_MYSQL=mysql://test:test@127.0.0.1/dbsimple_test phpunit",
        "examples": "for f in examples/[0-9]*.php; do echo \"### $f\"; php \"$f\" > /dev/null || exit 1; done"
    }
}
